# Run with APOREE_TEST_STREAM pointing to a long MP3 fixture.
wait 6000
expect ap_playing 1
tap ARP
expect page 6
expect sam_active 1
tap REC
expect sam_state 1
wait 1000
expect sam_len >7500
shot field-sampler-capturing.png
wait 2000
expect sam_state 2
expect sam_len 21824
turn K3 2
expect sam_pitch 2
tap SEL
expect sam_loop 1
key 7 down
wait 100
expect sam_voice 1
shot field-sampler.png
key 7 up
wait 40
expect sam_voice 0
tap ARP
expect page 0
expect sam_active 0
expect sam_state 2
expect sam_len 21824
key 7 down
wait 100
expect sam_voice 1
key 7 up
wait 40
expect sam_voice 0
tap REC
expect ap_fav_status 1
expect sam_state 2
expect sam_len 21824
tap SEQ
expect ap_favorites 1
tap SEQ
tap ARP
expect sam_state 2
tap REC
expect sam_state 1
wait 400
tap REC
expect sam_state 2
expect sam_len <5000
tap PLAY
expect sam_voice 1
tap PLAY
wait 40
expect sam_voice 0
tap HOME
tap ENV
expect page 9
expect fx_mode 1
expect sam_state 0
expect sam_len 0
tap REC
expect sam_state 0
expect ap_fav_status 2
key w0 down
wait 100
shot field-effects.png
key w0 up
tap ARP
expect page 6
expect fx_mode 0
expect sam_state 0
tap HOME
reboot
expect sam_state 0
